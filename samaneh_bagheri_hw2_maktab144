class Product:
    name = "ShopHub"
    price_increase_rate = 1.05
    def __init__(self,title,category,price):
        self.title = title
        self.category = category
        self.price = price
    def lable(self):
        return self.category +'-'+self.title
    def product_new_price(self,):
        self.new_price = self.price*self.price_increase_rate
        return self.new_price
    @staticmethod
    def new_product ( data):
        data = data.split("-")
        title = data[2]
        category = data[1]
        price = int(data[0])
        return Product(title,category,price)
    @staticmethod   
    def working_time(day):
        if day == "friday":
            return False
        else:
            return True
